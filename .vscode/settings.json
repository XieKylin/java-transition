{
  // 2026-11-07：从 IDEA 2023.1（语言级别上限 20）切到 VS Code。
  // 本工程 pom 用 maven.compiler.release=21，VS Code 的 Java 扩展会按 pom 走 21，不再报「不支持发行版本 21」。
  "java.configuration.runtimes": [
    { "name": "JavaSE-21", "path": "D:\\developkit\\jdk21", "default": true },
    { "name": "JavaSE-17", "path": "D:\\developkit\\jdk17" },
    { "name": "JavaSE-22", "path": "D:\\developkit\\jdk22" }
  ],
  "java.jdt.ls.java.home": "D:\\developkit\\jdk21",
  "java.configuration.updateBuildConfiguration": "automatic",
  "maven.executable.path": "D:\\developkit\\apache-maven-3.9.9\\bin\\mvn.cmd",

  // 不要加 -Dstdout.encoding=UTF-8：
  // Java 18+ 的 stdout 默认跟随控制台码表（本机 GBK/936），强行改 UTF-8 而终端仍按 GBK 解 = 乱码。
  // 只在重定向到文件、且确定按 UTF-8 读时才临时加。反射读 String.value 需要开包，这个要留着。
  "java.debug.settings.vmArgs": "--add-opens java.base/java.lang=ALL-UNNAMED",

  "files.encoding": "utf8",
  "editor.tabSize": 4,
  "editor.insertSpaces": true
}
